# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Required scopes: repo (for private), read:org (for organizations)
GITHUB_TOKEN=ghp_your_token_here

# Optional: Database path (default: ./data/ab_hub.db)
# AB_HUB_DB_PATH=./data/ab_hub.db

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# AB_HUB_LOG_LEVEL=INFO

# Optional: Concurrent requests limit
# AB_HUB_MAX_CONCURRENCY=5
